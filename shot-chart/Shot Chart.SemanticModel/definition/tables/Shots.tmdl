table Shots
	lineageTag: 2179f820-7fe6-78c2-bcef-7cd520ce0a98

	measure Attempts = COUNTROWS ( 'Shots' )
		formatString: #,0
		lineageTag: ffbb81bd-ec5f-08da-6eb6-40a308205e38

	measure Makes = SUM ( 'Shots'[Made] )
		formatString: #,0
		lineageTag: bbdcf8d0-5a00-acfe-b1bb-4307795d2350

	measure 'FG %' = DIVIDE ( [Makes], [Attempts] )
		formatString: 0.0%
		lineageTag: b0097b5e-adf0-9b7c-8589-1f4d829a2313

	measure Points = SUMX ( 'Shots', 'Shots'[Made] * IF ( 'Shots'[Shot Type] = "3PT", 3, 2 ) )
		formatString: #,0
		lineageTag: 44b05a15-27db-6f72-73da-406f12e8e208

	measure 'Points per Shot' = DIVIDE ( [Points], [Attempts] )
		formatString: #,0.00
		lineageTag: ac190913-f6e1-8e4b-92fe-813a727d6124

	measure 'Attempts PY' = CALCULATE ( [Attempts], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,0
		lineageTag: f74536ac-2841-0ac2-2254-8622016dacf5

	measure 'FG % PY' = CALCULATE ( [FG %], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: 0.0%
		lineageTag: 93494326-5f19-be83-238d-d56ef7141b2c

	measure 'Points per Shot PY' = CALCULATE ( [Points per Shot], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,0.00
		lineageTag: 5ca2a9e7-e737-2e93-f1f3-84a50b16ef88

	measure 'FG % shown' = IF ( [Attempts] < 11, BLANK (), [FG %] )  // honest data: no rate under 11 shots
		formatString: 0.0%
		lineageTag: 21cbb920-9a4d-052f-dda6-b92b395f6cf8

		annotation PBIK_Planned = 1

	measure 'FG % vs league' = IF ( ISBLANK ( [FG % shown] ), BLANK (), [FG % shown] - [League FG % by Area] )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 2eba6778-5b47-b1b3-5276-b8a491e7cfa3

		annotation PBIK_Planned = 1

	measure 'Shots headline' = VAR _n = [Attempts] VAR _top = TOPN ( 1, FILTER ( VALUES ( 'Zones'[Zone Label] ), [Attempts] >= 11 && NOT ISBLANK ( [FG % vs league] ) ), [FG % vs league], DESC, 'Zones'[Zone Label], ASC ) VAR _z = MAXX ( _top, 'Zones'[Zone Label] ) RETURN IF ( ISBLANK ( _n ), "No shots in this view.", FORMAT ( _n, "#,0" ) & IF ( _n = 1, " shot at ", " shots at " ) & FORMAT ( [FG %], "0.0%" ) & IF ( ISBLANK ( _z ), ".", "; " & _z & " is the hottest against the league." ) )
		lineageTag: 55f4c539-e43b-d4ac-6c63-86e9e64b92bb

		annotation PBIK_Planned = 1

	measure 'Attempts vs PY %' = VAR _py = [Attempts PY] RETURN IF ( NOT ISBLANK ( _py ), DIVIDE ( [Attempts] - _py, _py ) )
		formatString: "▲ "0.0%;"▼ "0.0%;0.0%
		lineageTag: 74bb0fd8-93c5-65d2-a4bd-bf99b5f4b5cf

		annotation PBIK_Planned = 1

	measure 'FG % vs PY (pts)' = VAR _py = [FG % PY] RETURN IF ( NOT ISBLANK ( _py ) && NOT ISBLANK ( [FG %] ), ( [FG %] - _py ) * 100 )
		formatString: """▲ ""0.0"" pts"";""▼ ""0.0"" pts"";0.0"" pts"""
		lineageTag: e9af610d-fe3b-d25f-2bd2-0e6d00ab83a5

		annotation PBIK_Planned = 1

	measure 'Points per Shot vs PY %' = VAR _py = [Points per Shot PY] RETURN IF ( NOT ISBLANK ( _py ), DIVIDE ( [Points per Shot] - _py, _py ) )
		formatString: "▲ "0.0%;"▼ "0.0%;0.0%
		lineageTag: a7313e67-d1a6-e91c-a376-6d42d0dbc3d1

		annotation PBIK_Planned = 1

	measure 'Attempts vs PY % colour' = IF ( ISBLANK ( [Attempts vs PY %] ), BLANK (), IF ( [Attempts vs PY %] >= 0, "#4CC38A", "#F07B72" ) )
		lineageTag: 478528ca-d0e9-3d57-15d7-f815a9f910e2

		annotation PBIK_Planned = 1

	measure 'FG % vs PY (pts) colour' = IF ( ISBLANK ( [FG % vs PY (pts)] ), BLANK (), IF ( [FG % vs PY (pts)] >= 0, "#4CC38A", "#F07B72" ) )
		lineageTag: bf494aa4-6bef-8cda-4517-c99943b47fff

		annotation PBIK_Planned = 1

	measure 'Points per Shot vs PY % colour' = IF ( ISBLANK ( [Points per Shot vs PY %] ), BLANK (), IF ( [Points per Shot vs PY %] >= 0, "#4CC38A", "#F07B72" ) )
		lineageTag: bf6307ec-5476-e933-dd15-128bf5c58775

		annotation PBIK_Planned = 1

	measure 'FG % quarter colour' = VAR _best = MAXX ( ALLSELECTED ( 'Shots'[Quarter], 'Shots'[Period] ), [FG %] ) RETURN IF ( NOT ISBLANK ( [FG %] ) && [FG %] = _best, "#F2A541", "#9AA8BD" )  // one accent: the best quarter
		lineageTag: 90a3bbfc-32ce-c5f9-f09b-7e2145b47f2b

		annotation PBIK_Planned = 1

	measure 'League FG % by Area' = CALCULATE ( [FG %], REMOVEFILTERS ( 'Shots'[Shot ID], 'Shots'[Player], 'Shots'[Team], 'Shots'[Game Date], 'Shots'[Period], 'Shots'[Quarter], 'Shots'[Shot Type] ) )  // the league: every team, player, game and quarter; the same area and season
		formatString: 0.0%
		lineageTag: 07a4082c-d902-6fe7-8066-cb20a89318fb

		annotation PBIK_Planned = 1

