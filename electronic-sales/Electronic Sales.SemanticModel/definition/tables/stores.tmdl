	column 'Location Order' = SWITCH ( stores[Store_Location], "Downtown", 1, "Commercial", 2, "Residential", 3, "Airport", 4, 5 )
		dataType: int64
		lineageTag: 951e96a3-f0be-4c27-cdf7-48f27fdff176
		summarizeBy: sum

	column 'Location Type' = stores[Store_Location]
		dataType: string
		lineageTag: eedf7bbb-6719-0b62-77e4-f0f9d86f88b2
		summarizeBy: none
		sortByColumn: 'Location Order'

	column Store = SUBSTITUTE ( stores[Store_Name], "Maven Toys ", "" )
		dataType: string
		lineageTag: a424f2f8-1601-cdc4-d02e-576043336d76
		summarizeBy: none

	column City = SUBSTITUTE ( stores[Store_City], "Cuidad", "Ciudad" )
		dataType: string
		lineageTag: 1015c6ef-f522-c5b2-255b-5b95ac8279ae
		summarizeBy: none

	partition stores = calculated
		mode: import
		source =
				DATATABLE (
					"Store_ID", INTEGER,
					"Store_Name", STRING,
					"Store_City", STRING,
					"Store_Location", STRING,
					{
						{ 1, "Store_Name 1", "Store_City 1", "Store_Location 1" },
						{ 2, "Store_Name 2", "Store_City 2", "Store_Location 2" },
						{ 3, "Store_Name 3", "Store_City 3", "Store_Location 3" },
						{ 4, "Store_Name 4", "Store_City 4", "Store_Location 4" },
						{ 5, "Store_Name 5", "Store_City 5", "Store_Location 5" },
						{ 6, "Store_Name 6", "Store_City 6", "Store_Location 6" },
						{ 7, "Store_Name 6", "Store_City 4", "Store_Location 2" },
